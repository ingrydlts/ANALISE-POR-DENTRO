# Por Dentro — variáveis de ambiente unificadas (todos os scripts em scripts/)
# Em GitHub Actions, isso vira Secrets do repositório — não commitar um .env real.

# ── Notion ──────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FICHIERS INSTAGRAM — entradas cruas CONCORRÊNCIA (YouTube+Instagram) e AUDIÊNCIA.
# Usada por collect.py e analyze_concorrencia.py.
NOTION_DB_ID=2f3d602254ce80499fd5e9b27a782a60

# COLETAS YOUTUBE — 1 linha por canal coletado a cada sexta.
# collect.py escreve, analyze_concorrencia.py lê.
NOTION_COLETAS_DB_ID=dcfd52a461cd492bac2ce924edcd3fbc

# 🎯 Benchmarks de Concorrência (Mensal) — 1 linha por mês (upsert por "ID Mês").
# Usada por analyze_concorrencia.py.
NOTION_BENCHMARKS_DB_ID=497968f4d9fe4283a134c86e1276c70d

# Inputs Benchmark Instagram — prints de AUDIÊNCIA (DMs/comentários/stories) E de
# CONCORRÊNCIA (posts/reels de concorrentes), distinguidos pela propriedade CATEGORIA.
# Usada por enriquecer_conversas_audiencia.py, analyze_audiencia.py e analyze_concorrencia.py.
NOTION_DB_IG=71b72c25dfea43b581b47dfd252b03e7

# 📊 Análises de Audiência (Semanal) — 1 linha por semana (upsert por "ID Semana").
# Usada por analyze_audiencia.py e gerar_sugestoes_conteudo.py.
NOTION_ANALISES_DB_ID=3617eb0340c5466283ea1b239071d235

# INSTA TO POR DENTRO — o calendário editorial real (Posting Date, Stage, Formato etc.).
# Usada por gerar_sugestoes_conteudo.py pra checar duplicata, criar sugestões e
# recarregar calendario_posts no insights.json (alimenta o Calendário Real do dashboard).
NOTION_CALENDARIO_DB_ID=fa40f95ba416401fb7af9dfd12061e15

# Major Tasks Database — usada por create_tasks.py (Módulo 7). Tem um default
# hardcoded no script; só precisa ser setada aqui se o database mudar.
# NOTION_DB_ID_TASKS=1abd6022-54ce-8137-b4d0-dca737cc669d

# ── APIs externas ───────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dashboard (insights.json) ───────────────────────────────────────────────
# Caminho do insights.json relativo à raiz do repositório. Só precisa mudar se o
# arquivo for movido — o padrão já funciona quando os workflows rodam a partir
# da raiz do repo (actions/checkout) e chamam "python scripts/analyze_*.py".
# INSIGHTS_JSON_PATH=insights.json
